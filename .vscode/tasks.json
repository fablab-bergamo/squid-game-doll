{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP32: Sync All Files",
            "type": "shell",
            "command": "./esp32/sync.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP32: Open REPL",
            "type": "shell",
            "command": "mpremote",
            "args": ["repl"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP32: Show Logs",
            "type": "shell",
            "command": "mpremote",
            "args": ["repl", "--capture-output"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "ESP32: Reset Device",
            "type": "shell",
            "command": "mpremote",
            "args": ["reset"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP32: Soft Reset",
            "type": "shell",
            "command": "mpremote",
            "args": ["eval", "import machine; machine.soft_reset()"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP32: List Files",
            "type": "shell",
            "command": "mpremote",
            "args": ["fs", "ls"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ESP32: Check Status",
            "type": "shell",
            "command": "mpremote",
            "args": ["eval", "print('ESP32 connected and responding!')"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}